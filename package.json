{
  "name": "@huai_xin/dsh-workbuddy",
  "version": "0.1.7",
  "description": "WorkBuddy model provider for DeepSeek Harness (international + China deployments)",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp"
  },
  "files": [
    "src",
    "client",
    "docs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.webp",
    "icon-mask.png",
    "README.md"
  ],
  "scripts": {
    "test": "node test/unit/plugin.mjs && node test/unit/api.mjs && node test/unit/client.mjs && node test/unit/region-order.mjs && node test/unit/catalog.mjs && node test/unit/catalog-cache.mjs && node test/unit/official-list.mjs && node test/unit/model-prefs.mjs && node test/unit/availability.mjs && node test/unit/adapter.mjs",
    "smoke": "node test/live/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm-provider",
    "workbuddy"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2424830124/dsh-workbuddy.git"
  },
  "homepage": "https://github.com/2424830124/dsh-workbuddy#readme",
  "bugs": {
    "url": "https://github.com/2424830124/dsh-workbuddy/issues"
  }
}
